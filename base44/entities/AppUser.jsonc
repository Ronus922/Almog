{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d8\u05d9"
    },
    "last_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "username": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 (\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea \u05d1\u05dc\u05d1\u05d3)"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d3\u05d5\u05d0\u05f4\u05dc"
    },
    "password_hash": {
      "type": "string",
      "description": "\u05e1\u05d9\u05e1\u05de\u05d4 \u05de\u05d5\u05e6\u05e4\u05e0\u05ea"
    },
    "role": {
      "type": "string",
      "enum": [
        "SUPER_ADMIN",
        "ADMIN",
        "VIEWER"
      ],
      "default": "VIEWER",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05e2\u05e8\u05db\u05ea"
    },
    "role_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05d5\u05ea\u05d0\u05dd (FK -> Role.id)"
    },
    "department": {
      "type": "string",
      "description": "\u05de\u05d7\u05dc\u05e7\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e4\u05e2\u05d9\u05dc"
    },
    "base44_user_invited": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d5\u05d6\u05de\u05df \u05dc\u05de\u05e2\u05e8\u05db\u05ea Base44"
    }
  },
  "required": [
    "first_name",
    "username",
    "password_hash",
    "role"
  ]
}