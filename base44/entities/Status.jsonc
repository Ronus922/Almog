{
  "name": "Status",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "type": {
      "type": "string",
      "enum": [
        "LEGAL",
        "GENERAL"
      ],
      "default": "GENERAL",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05ea\u05d2",
      "default": "bg-slate-100 text-slate-700"
    },
    "is_active": {
      "type": "boolean",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e4\u05e2\u05d9\u05dc",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc (\u05e8\u05e7 \u05d0\u05d7\u05d3 \u05de\u05e1\u05d5\u05d2 LEGAL)",
      "default": false
    },
    "notification_emails": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05d5\u05ea \u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05dc\u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea (\u05de\u05d5\u05e4\u05e8\u05d3\u05d5\u05ea \u05d1\u05e4\u05e1\u05d9\u05e7\u05d9\u05dd)"
    }
  },
  "required": [
    "name",
    "type"
  ]
}