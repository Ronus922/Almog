{
  "name": "TaskComment",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "FK -> Task.id"
    },
    "comment_text": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e2\u05e8\u05d4"
    },
    "created_by_username": {
      "type": "string",
      "description": "\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d9\u05e6\u05e8"
    },
    "created_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d9\u05e6\u05e8"
    },
    "is_edited": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05e0\u05e2\u05e8\u05db\u05d4"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05e0\u05de\u05d7\u05e7\u05d4 (soft delete)"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05de\u05d7\u05d9\u05e7\u05d4"
    }
  },
  "required": [
    "task_id",
    "comment_text",
    "created_by_username"
  ]
}