{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "room",
        "area"
      ],
      "default": "room",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d9\u05e2\u05d3"
    },
    "target_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d9\u05e2\u05d3 (\u05d7\u05d3\u05e8 \u05d0\u05d5 \u05d0\u05d6\u05d5\u05e8)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "high",
        "urgent"
      ],
      "default": "low",
      "description": "\u05d3\u05d7\u05d9\u05e4\u05d5\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "reporter_email": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d0\u05f4\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05e9\u05de\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05d4\u05d5\u05e7\u05e6\u05ea\u05d4 \u05dc\u05d4\u05dd \u05d4\u05de\u05e9\u05d9\u05de\u05d4 (\u05de\u05d5\u05e4\u05e8\u05d3\u05d9\u05dd \u05d1\u05e4\u05e1\u05d9\u05e7)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs \u05e9\u05dc \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05de\u05e6\u05d5\u05e8\u05e4\u05d5\u05ea"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs \u05e9\u05dc \u05e1\u05e8\u05d8\u05d5\u05e0\u05d9\u05dd \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "history": {
      "type": "array",
      "default": [],
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd"
    }
  },
  "required": [
    "title",
    "description",
    "target_type",
    "target_id",
    "priority",
    "status"
  ]
}