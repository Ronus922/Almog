{
  "name": "DocumentFolder",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4"
    },
    "parent_folder_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05d4\u05d0\u05d1"
    },
    "color_key": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4"
    },
    "visibility_mode": {
      "type": "string",
      "enum": [
        "all_users",
        "restricted",
        "private"
      ],
      "default": "all_users",
      "description": "\u05de\u05e6\u05d1 \u05d4\u05d2\u05dc\u05d5\u05bc\u05d9\u05d5\u05bc\u05ea"
    },
    "inherit_to_children": {
      "type": "boolean",
      "default": true,
      "description": "\u05d9\u05d5\u05e8\u05e9 \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05dc\u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05ea\u05ea"
    },
    "inherit_to_files": {
      "type": "boolean",
      "default": true,
      "description": "\u05d9\u05d5\u05e8\u05e9 \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05dc\u05e7\u05d1\u05e6\u05d9\u05dd"
    },
    "owner_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc\u05d9\u05dd"
    },
    "is_starred": {
      "type": "boolean",
      "default": false,
      "description": "\u05db\u05d5\u05db\u05d1 \u05de\u05e1\u05d5\u05de\u05df"
    },
    "is_system_folder": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05de\u05e2\u05e8\u05db\u05ea"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e0\u05de\u05d7\u05e7\u05d4 \u05dctrash"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05d7\u05d9\u05e7\u05d4"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05de\u05d9\u05d5\u05df"
    },
    "path_cache": {
      "type": "string",
      "description": "\u05e0\u05ea\u05d9\u05d1 \u05de\u05d8\u05de\u05d5\u05df"
    }
  },
  "required": [
    "name"
  ]
}