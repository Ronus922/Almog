{
  "name": "ImportRun",
  "type": "object",
  "properties": {
    "importRunId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e8\u05d9\u05e6\u05ea \u05d9\u05d9\u05d1\u05d5\u05d0"
    },
    "fileName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e7\u05d5\u05d1\u05e5 \u05d4\u05d0\u05e7\u05e1\u05dc"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "SUCCESS",
        "PARTIAL",
        "FAILED"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e8\u05d9\u05e6\u05d4",
      "default": "RUNNING"
    },
    "stage": {
      "type": "string",
      "description": "\u05e9\u05dc\u05d1 \u05e0\u05d5\u05db\u05d7\u05d9: READ_EXCEL / VALIDATION / UPSERT / POST_PROCESS / QA / COMPLETE"
    },
    "totalRowsRead": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05e9\u05d5\u05e8\u05d5\u05ea \u05e9\u05e0\u05e7\u05e8\u05d0\u05d5 \u05de\u05d4\u05e7\u05d5\u05d1\u05e5",
      "default": 0
    },
    "uniqueApartments": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d3\u05d9\u05e8\u05d5\u05ea \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d5\u05ea",
      "default": 0
    },
    "successRowsCount": {
      "type": "number",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05e9\u05e2\u05d5\u05d1\u05d3\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4",
      "default": 0
    },
    "createdCount": {
      "type": "number",
      "description": "\u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea \u05e9\u05e0\u05d5\u05e6\u05e8\u05d5",
      "default": 0
    },
    "updatedCount": {
      "type": "number",
      "description": "\u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e9\u05e2\u05d5\u05d3\u05db\u05e0\u05d5",
      "default": 0
    },
    "failedRowsCount": {
      "type": "number",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05e9\u05e0\u05db\u05e9\u05dc\u05d5",
      "default": 0
    },
    "skippedRowsCount": {
      "type": "number",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05e9\u05d3\u05d5\u05dc\u05d2\u05d5 (\u05e8\u05d9\u05e7\u05d5\u05ea)",
      "default": 0
    },
    "clearedCount": {
      "type": "number",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05d0\u05d5\u05e4\u05e1\u05d5 (\u05dc\u05d0 \u05d1\u05e7\u05d5\u05d1\u05e5)",
      "default": 0
    },
    "invalidMonthlyCount": {
      "type": "number",
      "description": "\u05e2\u05e8\u05db\u05d9 \u05d3\u05de\u05d9 \u05e0\u05d9\u05d4\u05d5\u05dc \u05dc\u05d0 \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd",
      "default": 0
    },
    "invalidSpecialCount": {
      "type": "number",
      "description": "\u05e2\u05e8\u05db\u05d9 \u05de\u05d9\u05dd \u05d7\u05de\u05d9\u05dd \u05dc\u05d0 \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd",
      "default": 0
    },
    "errorSummary": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05e9\u05d2\u05d9\u05d0\u05d5\u05ea"
    },
    "errorDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rowIndex": {
            "type": "number"
          },
          "apartmentNumber": {
            "type": "string"
          },
          "errorType": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05e9\u05d2\u05d9\u05d0\u05d5\u05ea \u05de\u05e4\u05d5\u05e8\u05d8\u05ea"
    },
    "qaValidation": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05e2\u05d1\u05e8 \u05d5\u05dc\u05d9\u05d3\u05e6\u05d9\u05d9\u05ea QA"
    },
    "qaDelta": {
      "type": "number",
      "description": "\u05e4\u05e2\u05e8 \u05d1\u05e1\u05db\u05d5\u05de\u05d9\u05dd (QA)"
    },
    "importMode": {
      "type": "string",
      "enum": [
        "fill_missing",
        "reset"
      ],
      "description": "\u05de\u05e6\u05d1 \u05d9\u05d9\u05d1\u05d5\u05d0"
    }
  },
  "required": [
    "importRunId",
    "startedAt",
    "status"
  ]
}