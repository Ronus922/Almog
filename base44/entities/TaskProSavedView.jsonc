{
  "name": "TaskProSavedView",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "owner_username": {
      "type": "string",
      "description": "\u05d1\u05e2\u05dc \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "is_shared": {
      "type": "boolean",
      "default": false
    },
    "filters_json": {
      "type": "string",
      "description": "JSON \u05e9\u05dc \u05d4\u05e4\u05d9\u05dc\u05d8\u05e8\u05d9\u05dd \u05d4\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd"
    },
    "sort_field": {
      "type": "string"
    },
    "sort_dir": {
      "type": "string"
    },
    "view_mode": {
      "type": "string",
      "enum": [
        "table",
        "kanban",
        "calendar"
      ],
      "default": "table"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
