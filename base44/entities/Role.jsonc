{
  "name": "Role",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "color": {
      "type": "string",
      "enum": [
        "blue",
        "green",
        "purple",
        "orange",
        "red",
        "pink",
        "yellow",
        "indigo"
      ],
      "default": "blue",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05de\u05de\u05e9\u05e7"
    },
    "accessible_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d3\u05e4\u05d9\u05dd \u05e0\u05d2\u05d9\u05e9\u05d9\u05dd \u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d6\u05d4"
    },
    "can_edit_records": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05e8\u05d5\u05da \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e7\u05d9\u05d9\u05de\u05d5\u05ea"
    },
    "can_add_records": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea"
    },
    "can_delete_records": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05de\u05d7\u05d5\u05e7 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea"
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d6\u05d4 \u05de\u05e7\u05d1\u05dc \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05de\u05e0\u05d4\u05dc \u05de\u05dc\u05d0\u05d5\u05ea (\u05d2\u05d9\u05e9\u05d4 \u05dc\u05db\u05dc \u05d4\u05d3\u05e4\u05d9\u05dd)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "name"
  ]
}