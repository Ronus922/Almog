{
  "name": "CalendarHoliday",
  "type": "object",
  "properties": {
    "holiday_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d7\u05d2"
    },
    "holiday_name_he": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d2 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "holiday_name_en": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d2 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "is_shabbat": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4\u05d5 \u05e9\u05d1\u05ea"
    },
    "is_holiday": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4\u05d5 \u05d7\u05d2 \u05e8\u05e9\u05de\u05d9"
    },
    "holiday_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05d2"
    },
    "source_name": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "holiday_date"
  ]
}