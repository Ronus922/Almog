{
  "name": "DebtSnapshot",
  "type": "object",
  "properties": {
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05e6\u05d1"
    },
    "total_debt": {
      "type": "number",
      "description": "\u05e1\u05da \u05d7\u05d5\u05d1 \u05db\u05d5\u05dc\u05dc \u05d1\u05d1\u05e0\u05d9\u05d9\u05df \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d9\u05d5\u05dd",
      "default": 0
    },
    "monthly_debt": {
      "type": "number",
      "description": "\u05e1\u05da \u05d3\u05de\u05d9 \u05e0\u05d9\u05d4\u05d5\u05dc",
      "default": 0
    },
    "special_debt": {
      "type": "number",
      "description": "\u05e1\u05da \u05de\u05d9\u05dd \u05d7\u05de\u05d9\u05dd",
      "default": 0
    },
    "debtor_count": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd",
      "default": 0
    },
    "import_run_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e8\u05d9\u05e6\u05ea \u05d4\u05d9\u05d9\u05d1\u05d5\u05d0 \u05e9\u05d9\u05e6\u05e8\u05d4 \u05d0\u05ea \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05e6\u05d1"
    }
  },
  "required": [
    "snapshot_date",
    "total_debt"
  ]
}