{
  "name": "TaskProTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea"
    },
    "description": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "default_priority": {
      "type": "string",
      "enum": [
        "\u05d2\u05d1\u05d5\u05d4\u05d4",
        "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea",
        "\u05e0\u05de\u05d5\u05db\u05d4"
      ],
      "default": "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea"
    },
    "default_status": {
      "type": "string",
      "enum": [
        "\u05e4\u05ea\u05d5\u05d7\u05d4",
        "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc",
        "\u05d4\u05d5\u05e9\u05dc\u05de\u05d4",
        "\u05d1\u05d5\u05d8\u05dc\u05d4",
        "\u05de\u05de\u05ea\u05d9\u05e0\u05d4"
      ],
      "default": "\u05e4\u05ea\u05d5\u05d7\u05d4"
    },
    "default_description": {
      "type": "string"
    },
    "default_assigned_to": {
      "type": "string"
    },
    "default_assigned_to_name": {
      "type": "string"
    },
    "due_days_from_now": {
      "type": "number",
      "description": "\u05d9\u05de\u05d9\u05dd \u05e2\u05d3 \u05dc\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d9\u05e2\u05d3 \u05de\u05d9\u05d5\u05dd \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "task_type"
  ]
}