{
  "name": "TaskReminder",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "FK -> Task.id"
    },
    "user_username": {
      "type": "string",
      "description": "\u05de\u05e9\u05ea\u05de\u05e9 \u05dc\u05ea\u05d6\u05db\u05d5\u05e8\u05ea"
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "before_due",
        "on_due",
        "overdue",
        "custom",
        "digest"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea"
    },
    "remind_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05ea\u05d6\u05db\u05d5\u05e8\u05ea"
    },
    "channel": {
      "type": "string",
      "enum": [
        "in_app",
        "email",
        "whatsapp"
      ],
      "default": "in_app",
      "description": "\u05e2\u05e8\u05d5\u05e5 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "canceled"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "error_message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 \u05d0\u05dd \u05e0\u05db\u05e9\u05dc"
    }
  },
  "required": [
    "task_id",
    "user_username",
    "reminder_type",
    "remind_at"
  ]
}