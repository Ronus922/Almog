{
  "name": "BroadcastCampaign",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "message": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "target_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05d9\u05e2\u05d3: owners, tenants, operators, suppliers, all"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "running",
        "paused",
        "completed",
        "failed"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "total_recipients": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d4\"\u05db \u05e0\u05de\u05e2\u05e0\u05d9\u05dd"
    },
    "sent_count": {
      "type": "number",
      "default": 0,
      "description": "\u05e0\u05e9\u05dc\u05d7 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "failed_count": {
      "type": "number",
      "default": 0,
      "description": "\u05e0\u05db\u05e9\u05dc"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05ea\u05d7\u05d9\u05dc\u05ea \u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "created_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d9 \u05e9\u05d9\u05e6\u05e8"
    }
  },
  "required": [
    "title",
    "message",
    "target_groups"
  ]
}