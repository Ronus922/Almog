{
  "name": "CalendarEventParticipant",
  "type": "object",
  "properties": {
    "calendar_event_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "participant_source": {
      "type": "string",
      "enum": [
        "user",
        "resident",
        "supplier"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05ea\u05ea\u05e3"
    },
    "participant_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05ea\u05e3"
    },
    "display_name_cache": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05d4\u05e6\u05d2\u05d4"
    },
    "email_cache": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d0\u05f4\u05dc"
    },
    "phone_cache": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
