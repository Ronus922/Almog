{
  "name": "DocumentLink",
  "type": "object",
  "properties": {
    "linked_type": {
      "type": "string",
      "enum": [
        "calendar_event",
        "task",
        "resident",
        "supplier",
        "apartment",
        "building",
        "maintenance_record",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d9\u05e9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05ea"
    },
    "linked_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d9\u05e9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05ea"
    },
    "document_file_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d5\u05d1\u05e5 \u05de\u05e1\u05de\u05da"
    },
    "document_folder_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05de\u05e1\u05de\u05da"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05ea\u05de\u05e9 \u05d9\u05d5\u05e6\u05e8"
    }
  },
  "required": [
    "linked_type",
    "linked_id"
  ]
}