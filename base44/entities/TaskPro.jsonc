{
  "name": "TaskPro",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "\u05e9\u05d9\u05d7\u05ea \u05d8\u05dc\u05e4\u05d5\u05df",
        "\u05e9\u05dc\u05d9\u05d7\u05ea \u05de\u05db\u05ea\u05d1 \u05d4\u05ea\u05e8\u05d0\u05d4",
        "\u05e4\u05d2\u05d9\u05e9\u05d4",
        "\u05de\u05e2\u05e7\u05d1 \u05ea\u05e9\u05dc\u05d5\u05dd",
        "\u05d4\u05d2\u05e9\u05ea \u05ea\u05d1\u05d9\u05e2\u05d4",
        "\u05de\u05e9\u05d9\u05de\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05e4\u05ea\u05d5\u05d7\u05d4",
        "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc",
        "\u05d4\u05d5\u05e9\u05dc\u05de\u05d4",
        "\u05d1\u05d5\u05d8\u05dc\u05d4",
        "\u05de\u05de\u05ea\u05d9\u05e0\u05d4"
      ],
      "default": "\u05e4\u05ea\u05d5\u05d7\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "\u05d2\u05d1\u05d5\u05d4\u05d4",
        "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea",
        "\u05e0\u05de\u05d5\u05db\u05d4"
      ],
      "default": "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea",
      "description": "\u05ea\u05d2\u05d9\u05ea \u05e2\u05e1\u05e7\u05d9\u05ea \u2014 \u05dc\u05d0 \u05dc\u05de\u05d8\u05e8\u05d5\u05ea \u05e1\u05d9\u05d3\u05d5\u05e8"
    },
    "manual_order": {
      "type": "number",
      "description": "\u05e1\u05d3\u05e8 \u05d9\u05d3\u05e0\u05d9 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u2014 \u05d2\u05d1\u05d5\u05d4 = \u05dc\u05de\u05e2\u05dc\u05d4",
      "default": 0
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05e9\u05d5\u05d9\u05da \u05d4\u05e8\u05d0\u05e9\u05d9"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05de\u05e9\u05d5\u05d9\u05da \u05e8\u05d0\u05e9\u05d9"
    },
    "assigned_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d4\u05e7\u05e6\u05d4 \u05d0\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "assigned_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d9 \u05e9\u05d4\u05e7\u05e6\u05d4"
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completion_notes": {
      "type": "string"
    },
    "debtor_record_id": {
      "type": "string",
      "description": "FK -> DebtorRecord.id"
    },
    "apartment_number": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "template",
        "recurring"
      ],
      "default": "manual",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "template_id": {
      "type": "string",
      "description": "FK -> TaskProTemplate.id"
    },
    "recurrence_rule_id": {
      "type": "string",
      "description": "FK -> TaskProRecurrenceRule.id"
    },
    "recurrence_instance_index": {
      "type": "number"
    },
    "is_recurring_instance": {
      "type": "boolean",
      "default": false
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by": {
      "type": "string"
    },
    "archive_reason": {
      "type": "string"
    },
    "snooze_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "task_type",
    "status",
    "priority"
  ]
}