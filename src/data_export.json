  "Comment": [
    { "id": "69e7aae87829088ad84f215e", "created_at": "2026-04-21T16:50:48.961Z", "updated_at": "2026-04-21T16:50:48.961Z", "created_by": "r@bios.co.il", "debtor_record_id": "69b6822a35dbdd16f820a406", "apartment_number": "1210", "content": "📱 הודעת וואטסאפ נשלחה ב-21.04.2026 19:50:\n\nשלום רונן משולם,\nאנו פונים אליך מטעם חברת הניהול של בניין אלמוג בנוגע לחוב שטרם הוסדר.\n\nנכון למועד זה, עומד חובך על הסכומים הבאים:\nדמי ניהול: 0 ש\"ח\nמים חמים: 450 ש\"ח\nסה״כ: 450 ש\"ח\n\nנבקשך להסדיר את התשלום בהקדם האפשרי, כדי להימנע מהמשך טיפול בנושא.\n\nלפרטים נוספים ניתן לפנות לחברת הניהול בטלפון: 052-6628944.", "author_name": "Ronen Meshulam", "author_email": "r@bios.co.il" },
    { "id": "69df4f50c702fdb9aa04e69b", "created_at": "2026-04-15T08:41:52.338Z", "updated_at": "2026-04-15T08:41:52.338Z", "created_by": "anonymous", "debtor_record_id": "69b6822a35dbdd16f820a3d5", "apartment_number": "1021", "content": "הוא יסדיר את התשלום באפליקציה \nאמר לי אם את רואה עוד שצריך לשלם תתקשרו אליי", "author_name": "חלא אבו סעדה", "author_email": "ronen.yeadim@gmail.com" },
    { "id": "69df4ec40d30c539b0dcb71c", "created_at": "2026-04-15T08:39:32.153Z", "updated_at": "2026-04-15T08:39:32.153Z", "created_by": "anonymous", "debtor_record_id": "69b6822a35dbdd16f820a358", "apartment_number": "546", "content": "המנוי אינו פעיל זמנית", "author_name": "חלא אבו סעדה", "author_email": "ronen.yeadim@gmail.com" },
    { "id": "69df4b17fc83a04cbc5f0933", "created_at": "2026-04-15T08:23:51.170Z", "updated_at": "2026-04-15T08:23:51.170Z", "created_by": "anonymous", "debtor_record_id": "69b6822a35dbdd16f820a41e", "apartment_number": "1305", "content": "התקשרתי לדיירת אנה והיא אמרה לי שתבוא עם כל התלושים ונסדיר את זה, הייתה מופתעת שהתקשרתי ואמרתי לה שיש לה חוב\nבקיצר היא תבוא...", "author_name": "חלא אבו סעדה", "author_email": "ronen.yeadim@gmail.com" },
    { "id": "69df465f60839bdd5d3c2df8", "created_at": "2026-04-15T08:03:43.456Z", "updated_at": "2026-04-15T08:03:43.456Z", "created_by": "anonymous", "debtor_record_id": "69b6822a35dbdd16f820a36a", "apartment_number": "633", "content": "היא עכשיו בצבא במילואים, אמרה לי שהיא תבוא לשלם אחרי שתסיים", "author_name": "חלא אבו סעדה", "author_email": "ronen.yeadim@gmail.com" }
